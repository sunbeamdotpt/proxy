# Pinned digest for alpine:3.19 (multi-arch index).
FROM alpine@sha256:6baf43584bcb78f2e5847d1de515f23499913ac9f12bdf834811a3145eb11ca1

RUN apk add --no-cache ca-certificates && \
    addgroup -g 65532 -S nonroot && \
    adduser -u 65532 -S -G nonroot -H -D nonroot

COPY --chown=65532:65532 target/aarch64-unknown-linux-musl/release/sunbeam-proxy /usr/local/bin/sunbeam-proxy
RUN chmod +x /usr/local/bin/sunbeam-proxy

USER 65532:65532

EXPOSE 8080 8443 9090

ENTRYPOINT ["/usr/local/bin/sunbeam-proxy"]
CMD ["serve"]
